# Level Type System Configuration
# Copy these to your .env.local file to enable level types

# Enable the level type system
NEXT_PUBLIC_LEVEL_TYPES_ENABLED=true

# Show level types in the UI
NEXT_PUBLIC_SHOW_LEVEL_TYPES=true

# Use v2 endpoints for typed level generation
NEXT_PUBLIC_USE_V2_ENDPOINTS=true

# Enforce validation (set to false for warnings only)
NEXT_PUBLIC_ENFORCE_LEVEL_TYPE_VALIDATION=true

# Gradual rollout configuration
# Percentage of new users to enable for (0-100)
NEXT_PUBLIC_LEVEL_TYPE_ROLLOUT_PERCENTAGE=100

# Comma-separated list of test user IDs
# NEXT_PUBLIC_LEVEL_TYPE_TEST_USERS=user1,user2,user3

# Full rollout date (YYYY-MM-DD)
# NEXT_PUBLIC_LEVEL_TYPE_FULL_ROLLOUT_DATE=2024-02-01